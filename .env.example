# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# ---- TomTom ----
TOMTOM_API_KEY=

# ---- Vantor (Vantor Hub / api.maxar.com) ----
# The probe supports three auth modes and reports which one actually works.
# Fill in whichever you were issued; you do not need all of them.
#
# Mode A — API key (simplest for a server-side proxy; sent as `maxar-api-key` header)
VANTOR_API_KEY=
#
# Mode B — OAuth2 client_credentials (what the original spec assumed)
VANTOR_CLIENT_ID=
VANTOR_CLIENT_SECRET=
#
# Mode C — OAuth2 password grant (what Vantor's docs actually document;
#          client_id defaults to "mgp" if VANTOR_CLIENT_ID is unset)
VANTOR_USERNAME=
VANTOR_PASSWORD=

# ---- Server ----
PORT=8080
