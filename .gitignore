# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
server/public/
client/dist/

# Probe artifacts (may contain vendor imagery)
server/scripts/vantor-sample.*
server/scripts/vantor-probe-report.json

# OS / editor
.DS_Store
*.log
.vscode/

# Demo POI cache — generated by `npm run cache:demo`.
#
# Deliberately TRACKED, not ignored. deploy.sh packages the app with
# `git archive HEAD`, an allowlist of tracked files, so an ignored cache would never
# reach Azure and the deployed demo would fall back to live fetching — losing the whole
# point of pre-caching it. It is 220 KB of derived data, which is a fair price for the
# deployed demo behaving like the local one. Still a pure fallback: delete it and live
# fetching resumes.
